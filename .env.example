# ──────────────────────────────────────────────────────────────────────────────
# Ryloom environment — copy to apps/web/.env.local (web) and apps/worker/.env
# See docs/DEPLOYMENT.md for where each value comes from.
# ──────────────────────────────────────────────────────────────────────────────

# ----- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Pooled connection string for the web app (Project Settings → Database →
# Connection string → Transaction pooler, port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Connection string for the worker: the SESSION pooler (port 5432 on the
# *.pooler.supabase.com host). Do NOT use the "direct" db.*.supabase.co host —
# it is IPv6-only on the free tier and unreachable from most container hosts.
WORKER_DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ----- Cloudflare R2 (video storage — raw + processed bytes) -------------------
# R2 dashboard → create bucket (default name: ryloom-media) → Manage API tokens
# → create an "Object Read & Write" token scoped to that bucket.
# IMPORTANT: set the bucket's CORS policy so browser uploads work — see
# docs/DEPLOYMENT.md ("Configure CORS"). Both web app AND worker need these.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ryloom-media"

# ----- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
IP_HASH_SALT="change-me-to-any-random-string"

# Internal-tool access control: only accounts on this email domain can sign in
# and use the app. Set to "*" to disable the restriction.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="lyratechnologies.com.au"

# Where the landing page's "Download for macOS" button points (e.g. a GitHub
# release asset URL). Leave empty to show build-from-source instructions.
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=""

# ----- Worker -------------------------------------------------------------------
# AI provider: set ONE of these. OPENAI_API_KEY (Whisper word-level timestamps →
# precise filler-word removal) or GEMINI_API_KEY (free tier via Google AI Studio,
# aistudio.google.com/apikey — transcription is segment-level).
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Model for AI outputs (defaults: gpt-4o-mini for OpenAI, gemini-2.5-flash for Gemini).
AI_MODEL=""
# How many jobs the worker runs concurrently.
WORKER_CONCURRENCY="2"
# Serverless mode (Modal): process the queue then exit instead of running 24/7.
WORKER_DRAIN="false"

# ----- Worker wake (web app) ----------------------------------------------------
# Cloud Run Jobs (recommended): the app starts a job execution the moment work
# is queued. GCP_SA_KEY = base64 of a service-account key JSON that has
# roles/run.invoker on the job (see docs/DEPLOYMENT.md step 4).
GCP_SA_KEY=""
CLOUD_RUN_PROJECT=""
CLOUD_RUN_REGION=""
CLOUD_RUN_JOB="ryloom-worker"
# Shared secret for /api/worker-backstop (Cloud Scheduler's fallback ping).
WORKER_BACKSTOP_TOKEN=""
# Alternative wake backend instead of Cloud Run: a plain webhook (e.g. the
# Modal wake endpoint printed by `modal deploy`).
WORKER_WAKE_URL=""
WORKER_WAKE_TOKEN=""

# ----- Email (optional — invite/notification emails via Resend) -------------------
RESEND_API_KEY=""
EMAIL_FROM="Ryloom <notifications@yourdomain.com>"

# ----- SCIM provisioning (optional) -------------------------------------------------
SCIM_ENABLED="false"
